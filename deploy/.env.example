# Copy to /opt/maretinda/.env on the server (chmod 600). Read by docker compose
# and by scripts/backup-db.sh. Never commit the real file.

# ── Domains (Caddy) ─────────────────────────────────────────────────────────
API_DOMAIN=api.maretinda.com
STORE_DOMAIN=maretinda.com

# ── Postgres ────────────────────────────────────────────────────────────────
# Keep the user as medusa_app: the Cloud SQL export assigns table ownership to it.
POSTGRES_USER=medusa_app
# Hex only (openssl rand -hex 24) — it is embedded in DATABASE_URL unescaped.
POSTGRES_PASSWORD=
POSTGRES_DB=medusa

# ── Scaling switches (stage 1) ──────────────────────────────────────────────
# MEDUSA_WORKER_MODE=server
# COMPOSE_PROFILES=split

# ── Backups → Cloudflare R2 ─────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=maretinda-backups
# Uploaded images/documents (served at media.maretinda.com); used by scripts/upload-media.sh
R2_MEDIA_BUCKET=maretinda-media
# 14 daily dumps stay far inside R2's 10 GB free storage for a small database.
BACKUP_RETENTION_DAYS=14
# Optional: a healthchecks.io (free) ping URL, so you hear about it when backups stop.
BACKUP_PING_URL=
