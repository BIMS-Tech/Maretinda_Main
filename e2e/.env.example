# Copy to e2e/.env (gitignored) and load with: set -a && . ./.env && set +a
# Never point write tests at production.

# Buyer signups become delivered+e2e-<tag>-<ts>@resend.dev (Resend's test inbox)
E2E_EMAIL=delivered@resend.dev
# Allow specs that create accounts, carts and orders on test
E2E_ALLOW_WRITES=1
# Test-only admin, created with `medusa user` on the test server
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Seller A: approved, PH shipping options, two published products with stock
E2E_SELLER_EMAIL=
E2E_SELLER_PASSWORD=
E2E_SELLER_ID=
# product_id:variant_id:price pairs for seller A, comma separated
E2E_SELLER_PRODUCTS=
# Seller B: approved, same setup, used for two-seller carts and ownership attacks
E2E_SELLER_B_EMAIL=
E2E_SELLER_B_PASSWORD=
E2E_SELLER_B_ID=
E2E_SELLER_B_PRODUCTS=
