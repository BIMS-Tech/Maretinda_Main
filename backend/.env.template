STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# ── Support assistant (RAG) ───────────────────────────────────────────────────
# Generation. Without this, POST /store/assistant returns an error to the widget.
ANTHROPIC_API_KEY=
# Embeddings, used at both index time and query time.
VOYAGE_API_KEY=
# Optional. Must be a 1024-dimension model to match assistant_document.embedding.
VOYAGE_MODEL=voyage-3.5
# Optional override for the generation model.
ASSISTANT_MODEL=claude-opus-4-8

# Courier webhooks are rejected unless these are set.
# Flying Tigers: signing secret from their portal. Ninja Van: your client secret.
FLYINGTIGERS_WEBHOOK_SECRET=
NINJAVAN_WEBHOOK_SECRET=

# Invoices (lib/invoice.ts). The operator's registered details printed on subscription invoices.
INVOICE_ISSUER_TIN=
INVOICE_ISSUER_VAT_REGISTERED=false
# Printed in every invoice footer once BIR has registered the invoicing system
INVOICE_BIR_PERMIT_TEXT=
# Where new seller applications are announced
SELLER_APPLICATION_NOTIFY_EMAIL=sales@bims.tech
