# Loaded before .env when NODE_ENV=test (Medusa's loadEnv reads both and the
# first file wins), so anything set here overrides a developer's local .env.
#
# Blank every external integration: integration tests must never send real
# email, index into Algolia, upload files or open a Redis-backed job queue.
REDIS_URL=
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
# The Resend provider refuses to load without a key; this one is rejected by
# Resend, so nothing can actually be delivered.
RESEND_API_KEY=re_test_not_a_real_key
# Mercur's payout module refuses to load without one; Stripe rejects this key.
STRIPE_SECRET_API_KEY=sk_test_not_a_real_key
STRIPE_CONNECTED_ACCOUNTS_WEBHOOK_SECRET=
VITE_TALK_JS_APP_ID=
VITE_TALK_JS_SECRET_API_KEY=
GCS_PROJECT_ID=
GCS_BUCKET_NAME=
GCS_KEY_FILE=
S3_ENDPOINT=
S3_BUCKET=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
MESHY_API_KEY=
# Carrier credentials live in the database, which starts empty, but point the
# client at a closed port anyway so a stray call can't book a real pickup.
FLYINGTIGERS_BASE_URL=http://127.0.0.1:9
# Fixed values so webhook signature tests can sign real deliveries.
FLYINGTIGERS_WEBHOOK_SECRET=test-ft-webhook-secret
NINJAVAN_WEBHOOK_SECRET=test-nv-webhook-secret

# HTTP only: no scheduled jobs (settlement, subscription expiry, flash sales)
# or subscribers firing in the background of a test run.
MEDUSA_WORKER_MODE=server

JWT_SECRET=test-jwt-secret
COOKIE_SECRET=test-cookie-secret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7000
VENDOR_CORS=http://localhost:7001
AUTH_CORS=http://localhost:8000,http://localhost:7000,http://localhost:7001
STOREFRONT_URL=http://localhost:8000
SELLER_PANEL_URL=http://localhost:7001
